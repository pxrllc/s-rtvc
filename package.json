{
  "name": "sentinel-rtvc",
  "version": "0.1.6",
  "description": "Sentinel Real Time Voice Core",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "cache:build": "tsx --tsconfig tsconfig.node.json scripts/prebuild-cache.ts",
    "dist": "npm run build && electron-builder --win portable --config.artifactName=\"SentinelRTVC-v${version}b-win-x64.exe\"",
    "sync:public": "tsx --tsconfig tsconfig.node.json scripts/sync-public.ts"
  },
  "build": {
    "appId": "com.sentinel.rtvc",
    "productName": "Sentinel RTVC",
    "copyright": "Sentinel RTVC",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "out/**/*",
      "cache/**/*",
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": ["koffi/**/*"]
      }
    ],
    "extraResources": [
      { "from": "cache/audio", "to": "cache/audio", "filter": ["**/*"] }
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "koffi": "^2.15.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
